{
  "apiKey": 29,
  "type": "metadata",
  "name": "PartitionRetirementAuthorityRecord",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "TopicId", "type": "uuid", "versions": "0+",
      "about": "Immutable topic incarnation. Never use the recyclable topic name." },
    { "name": "PartitionId", "type": "int32", "versions": "0+",
      "about": "The partition number." },
    { "name": "AuthorityOffset", "type": "int64", "versions": "0+",
      "about": "Last accepted retirement authority transition offset in the KRaft log." },
    { "name": "SourceLeaderEpoch", "type": "int32", "versions": "0+",
      "about": "Highest source partition leader epoch accepted by the authority." },
    { "name": "BrokerId", "type": "int32", "versions": "0+",
      "about": "The active leader broker or -1 if there is none." },
    { "name": "LogStartOffset", "type": "int64", "versions": "0+", "default": "-1",
      "about": "Explicit monotonic source log start, or -1 if never initialized." },
    { "name": "TerminallyDeleted", "type": "bool", "versions": "0+", "default": "false",
      "about": "Irrevocable tombstone for this Topic ID and partition." }
  ]
}
