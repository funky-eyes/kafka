// Experimental, non-emitting, SNAPSHOT-ONLY representation of UNTRUSTED V1
// certificate diagnostics. A log V1 record carries a *previous* certificate
// CAS and has no field for its newly assigned KRaft append offset. A snapshot
// must preserve that accepted position explicitly to resume the CAS chain.
// This envelope has no producer ACK/physical GC authority, Broker fsync proof,
// Controller replay dispatch, or production snapshot writer.
{
  "apiKey": 31,
  "type": "metadata",
  "name": "WalReplicaDurabilityV1CheckpointRecord",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "TopicId", "type": "uuid", "versions": "0+",
      "about": "Immutable topic incarnation." },
    { "name": "PartitionId", "type": "int32", "versions": "0+" },
    { "name": "LeaderEpoch", "type": "int32", "versions": "0+" },
    { "name": "PartitionEpoch", "type": "int32", "versions": "0+" },
    { "name": "StartOffset", "type": "int64", "versions": "0+" },
    { "name": "EndOffset", "type": "int64", "versions": "0+" },
    { "name": "ControllerEpoch", "type": "int64", "versions": "0+" },
    { "name": "AcceptedKRaftOffset", "type": "int64", "versions": "0+",
      "about": "Actual accepted log V1 certificate offset, learned from trusted KRaft commit, NOT from the source payload." },
    { "name": "PreviousKRaftOffset", "type": "int64", "versions": "0+",
      "default": "-1",
      "about": "Previous accepted certificate log offset for audit; -1 for the first." },
    { "name": "AcceptedRaftEpoch", "type": "int32", "versions": "0+",
      "about": "Committed KRaft batch leader epoch of the accepted log V1 record." },
    { "name": "ReplicaReceipts", "type": "[]ReplicaReceipt", "versions": "0+",
      "about": "Untrusted, immutable-on-restore replica claims, never physical durability evidence.",
      "fields": [
        { "name": "BrokerId", "type": "int32", "versions": "0+" },
        { "name": "BrokerEpoch", "type": "int64", "versions": "0+" },
        { "name": "IncarnationId", "type": "uuid", "versions": "0+" },
        { "name": "StorageGeneration", "type": "int64", "versions": "0+" },
        { "name": "DurableEndOffset", "type": "int64", "versions": "0+" }
      ]
    },
    { "name": "WalSpans", "type": "[]WalSpan", "versions": "0+",
      "about": "Untrusted per-Broker ranges and claimed CRC32c checksums.",
      "fields": [
        { "name": "BrokerId", "type": "int32", "versions": "0+" },
        { "name": "StartOffset", "type": "int64", "versions": "0+" },
        { "name": "EndOffset", "type": "int64", "versions": "0+" },
        { "name": "Crc32c", "type": "int64", "versions": "0+" }
      ]
    }
  ]
}
