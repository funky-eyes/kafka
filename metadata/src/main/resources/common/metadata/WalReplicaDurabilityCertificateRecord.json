// Experimental, non-emitting KRaft WAL replica certificate envelope.
// Neither this record format nor its replay makes WAL bytes authoritative.
// Requires future metadata.version >= 4.4 and an independent negotiated
// certificate feature before any Controller is allowed to emit this record.
{
  "apiKey": 30,
  "type": "metadata",
  "name": "WalReplicaDurabilityCertificateRecord",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    { "name": "TopicId", "type": "uuid", "versions": "0+",
      "about": "Immutable topic incarnation, never the reusable topic name." },
    { "name": "PartitionId", "type": "int32", "versions": "0+",
      "about": "Kafka partition number." },
    { "name": "LeaderEpoch", "type": "int32", "versions": "0+",
      "about": "Source Kafka leader generation." },
    { "name": "PartitionEpoch", "type": "int32", "versions": "0+",
      "about": "KRaft partition configuration generation." },
    { "name": "StartOffset", "type": "int64", "versions": "0+",
      "about": "Inclusive Kafka start offset of the claimed durable range." },
    { "name": "EndOffset", "type": "int64", "versions": "0+",
      "about": "Exclusive Kafka end offset of the claimed durable range." },
    { "name": "ControllerEpoch", "type": "int64", "versions": "0+",
      "about": "Controller generation that originally proposed the record." },
    { "name": "KRaftOffset", "type": "int64", "versions": "0+",
      "about": "Claimed KRaft append offset; readers must independently verify it." },
    { "name": "ReplicaReceipts", "type": "[]ReplicaReceipt", "versions": "0+",
      "about": "Untrusted claims for independently identified durable replicas.",
      "fields": [
        { "name": "BrokerId", "type": "int32", "versions": "0+" },
        { "name": "BrokerEpoch", "type": "int64", "versions": "0+" },
        { "name": "IncarnationId", "type": "uuid", "versions": "0+" },
        { "name": "StorageGeneration", "type": "int64", "versions": "0+" },
        { "name": "DurableEndOffset", "type": "int64", "versions": "0+" }
      ]
    },
    { "name": "WalSpans", "type": "[]WalSpan", "versions": "0+",
      "about": "Untrusted ordered per-Broker spans; CRC must be verified against real disk bytes.",
      "fields": [
        { "name": "BrokerId", "type": "int32", "versions": "0+" },
        { "name": "StartOffset", "type": "int64", "versions": "0+" },
        { "name": "EndOffset", "type": "int64", "versions": "0+" },
        { "name": "Crc32c", "type": "int64", "versions": "0+",
          "about": "Claimed unsigned 32-bit CRC; never self-authenticating." }
      ]
    }
  ]
}
